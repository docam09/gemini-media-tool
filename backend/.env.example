# Copy to backend/.env and fill in your real key.
# Get one for free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override of the default model (must be one of the models listed by
# GET /models). Defaults to gemini-2.5-flash-lite, the fastest option.
# GEMINI_MODEL=gemini-2.5-flash-lite

# Bật chế độ phiên dịch trực tiếp hai chiều (mic → WebSocket → Soniox).
# Lấy key tại https://console.soniox.com. Key này chỉ ở lại backend: trình duyệt
# nhận temporary key sống 120s qua POST /soniox/session.
# SONIOX_API_KEY=
# SONIOX_MODEL=stt-rt-v5
